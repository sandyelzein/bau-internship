# ─────────────────────────────────────────────
# BAU Internship Management System - Backend
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Database (local Docker Compose defaults; never use these credentials in production)
DATABASE_URL="postgresql://bau_dev:local_dev_only@localhost:5433/bau_internship"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─────────────────────────────────────────────
# EMAIL (Mailtrap locally, Brevo SMTP in production)
# ─────────────────────────────────────────────
# Local testing uses Mailtrap. Railway NODE_ENV=production defaults to real SMTP.

EMAIL_MODE=test

# Mailtrap (test mode)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_password

# Brevo SMTP (production mode)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="BAU Internship System <verified-sender@your-domain.com>"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Temporary public student signup for app testing; leave false/ unset outside testing
ALLOW_PUBLIC_STUDENT_SIGNUP=false
